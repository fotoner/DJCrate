    "%@에 %@로 씁니다. 쓰기 전에 Mac에 백업하고 쓴 뒤 USB에서 다시 읽어 확인합니다. 끝날 때까지 USB를 뽑지 마세요." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Writes %2$@ to %1$@. The USB is backed up on this Mac first and read back afterward to verify. Don’t unplug the USB until it finishes."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@に%2$@で書き込みます。書き込む前にMacにバックアップし、書き込んだ後にUSBから読み直して確認します。終わるまでUSBを抜かないでください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@에 %2$@로 씁니다. 쓰기 전에 Mac에 백업하고 쓴 뒤 USB에서 다시 읽어 확인합니다. 끝날 때까지 USB를 뽑지 마세요."
          }
        }
      }
    },
    "%@에 OneLibrary를 더하기 전의 백업으로 되돌립니다. 끝날 때까지 USB를 뽑지 마세요." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Restore %@ from the backup made before adding OneLibrary. Keep the USB connected until it finishes."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@をOneLibrary追加前のバックアップから復元します。完了するまでUSBを抜かないでください。"
          }
        }
      }
    },
    "%@에 모르는 칸(%@)" : {
      "localizations" : {
