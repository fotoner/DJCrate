          }
        }
      }
    },
    "%@에도 들어 있는 곡이라 아직 지우지 않습니다(rekordbox에서 지우세요)" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This track is also in %@, so it won't be removed yet (remove it in rekordbox)"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@にも入っている曲なので、まだ削除しません（rekordboxで削除してください）"
          }
        }
      }
    },
    "%@에도 지정된 키입니다. 목록 위쪽 동작이 받습니다" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This key is also assigned to %@. The action higher in the list gets it"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@にも割り当てられているキーです。リストで上にある操作が受け取ります"
          }
        }
      }
    },
    "%@은 DJCrate가 쓴 뒤 기기에서 바뀌었습니다. 되돌리면 기기가 그 뒤에 쓴 내용을 잃습니다(재생 기록 등)." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ was changed on a player after DJCrate wrote to it. Restoring loses what the player wrote since then (play history, etc.)."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@はDJCrateが書き込んだ後に機器で変更されました。復元すると、機器がその後に書き込んだ内容（再生履歴など）が失われます。"
          }
        }
      }
    },
    "%@은 쓰지 않았습니다" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Not written: %@"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@は書き込みませんでした"
          }
        }
      }
    },
    "%@은 이미 있는 파일입니다. 덮지 않으니 다른 이름을 주세요" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ already exists. It won't be overwritten, so choose a different name"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@は既にあるファイルです。上書きしないので、別の名前を指定してください"
          }
        }
      }
    },
    "%@은 이미 추가한 곡입니다. 추가 목록에서 확인하세요" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ has already been added. Check the Added Tracks list"
