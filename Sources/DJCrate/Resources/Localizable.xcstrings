            "state" : "translated",
            "value" : "USBのファイルが計画時と異なるため削除しませんでした: %@"
          }
        }
      }
    },
    "USB 편집은 초안으로 쌓고 ‘USB에 쓰기…’로 반영합니다" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
