    },
    "USB 복원 대상이 그 사이 바뀌었거나 중단 상태를 확정할 수 없습니다. 백업을 확인하고 기기 변경을 버리는 복원으로 다시 승인하세요" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The USB restore target changed, or the interrupted state cannot be determined. Check the backup, then approve restoring again with device changes discarded."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "USBの復元対象が変更されたか、中断時の状態を確定できません。バックアップを確認し、デバイス側の変更を破棄する復元を再度承認してください。"
          }
        }
      }
    },
    "USB 복원을 미뤘습니다" : {
      "localizations" : {
