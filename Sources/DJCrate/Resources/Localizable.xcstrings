        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "USB上のすべてのトラックの次の情報でローカルのトラック情報を置き換える下書きを作成します。"
          }
        }
      }
    },
    "USB에 있던 기기 기록 행을 옮기는 방법" : {
