          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このUSBには書き込み待ちの下書きがあるため、同期のオン/オフを保存できませんでした。USB書き込み待ちで書き込むか破棄してから、もう一度変更してください。"
          }
