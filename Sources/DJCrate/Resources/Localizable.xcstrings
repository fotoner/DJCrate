          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "書き込む前に変更するファイルをMacにバックアップします。機器に差し込む前に結果を確認してください"
          }
        }
      }
    },
    "쓰기 전 백업" : {
