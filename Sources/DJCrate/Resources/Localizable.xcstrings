          "stringUnit" : {
            "state" : "translated",
            "value" : "追加した曲をrekordboxにインポートするXMLを作成します。"
          }
        }
      }
    },
    "추가한 곡의 %@은 rekordbox에 넣은 뒤 고치세요" : {
