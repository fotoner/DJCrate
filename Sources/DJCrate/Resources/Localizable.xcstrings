        "en" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "rekordbox was restored, but the album art draft for %lld track could not be revived. Check write access to the DJCrate data folder, then choose the album art for that track again."
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
