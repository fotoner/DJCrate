            "value" : "USBに書き込みませんでした"
          }
        }
      }
    },
    "USB에 쓰지 않았습니다. 조건을 확인한 뒤 다시 시도하세요" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nothing was written to the USB. Check the conditions and try again"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "USBに書き込みませんでした。条件を確認してから、もう一度お試しください"
