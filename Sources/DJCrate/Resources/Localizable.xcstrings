    "%@에 새 폴더" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "New Folder on %@"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@に新規フォルダ"
          }
        }
      }
    },
    "%@에 쓰다가 끊긴 기록이 있습니다. 회복하면 USB를 보고 마저 쓰거나 쓰기 전으로 되돌립니다. 되돌리기는 그 쓰기를 백업으로 되돌립니다. 기기에 꽂기 전에 하세요." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A write to %@ was interrupted. Recover checks the USB and either finishes the write or returns the USB to its state before the write. Restore returns the USB to the backup taken before that write. Do this before plugging it into a player."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@への書き込みが途中で止まった記録があります。回復するとUSBを確認し、書き込みを最後まで行うか書き込み前の状態に戻します。復元はその書き込みの前のバックアップに戻します。機器に挿す前に行ってください。"
          }
        }
      }
    },
    "%@에 없는 칸(%@)" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "missing columns in %@ (%@)"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@にない列（%@）"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@에 없는 칸(%2$@)"
          }
        }
      }
    },
    "%@에 유한한 숫자를 지정하세요" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
