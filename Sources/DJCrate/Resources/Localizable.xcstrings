        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "USBが機器で変更されたため、書き込みを続けませんでした。今のUSBの状態でもう一度プレビューしてから書き込んでください"
          }
        }
      }
    },
    "USB가 바뀌었습니다. USB를 다시 읽은 뒤 동기화하세요" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
