            "value" : "The local waveform analysis file is missing; analyze the track in rekordbox, then import the beat grid."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ローカルの波形解析ファイルがないため、rekordboxで曲を解析してからグリッドを取り込んでください。"
          }
        }
      }
    },
    "로컬 활성 루프를 초안으로 보존할 수 없으니 rekordbox에서 직접 가져오세요." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Local Active Loops cannot be preserved in drafts; import them directly in rekordbox."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ローカルのアクティブループは下書きとして保持できないため、rekordboxで直接取り込んでください。"
          }
        }
      }
    },
    "로컬에 없음" : {
      "localizations" : {
