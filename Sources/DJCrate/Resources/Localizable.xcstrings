            "value" : "%lld曲は削除しませんでした"
          }
        }
      }
    },
    "%lld곡은 쓴 뒤 새로 만든 초안이 백업의 초안과 다릅니다. 지금 초안을 남기면 그 곡의 백업 초안은 되살리지 않고, 백업 초안으로 바꾸면 지금 초안이 사라집니다." : {
      "localizations" : {
        "en" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "%lld track has a draft made after the write that differs from its backup draft. Keeping the current draft leaves the backup draft unrestored for that track; using the backup draft discards the current draft."
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "%lld tracks have drafts made after the write that differ from their backup drafts. Keeping the current drafts leaves the backup drafts unrestored for those tracks; using the backup drafts discards the current drafts."
                }
              }
            }
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld曲は、書き込み後に新しく作った下書きがバックアップの下書きと異なります。今の下書きを残すとその曲のバックアップの下書きは復元せず、バックアップの下書きに置き換えると今の下書きは消えます。"
          }
        }
      }
    },
    "%lld곡은 읽지 못함" : {
      "localizations" : {
        "en" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "Couldn't read %lld track"
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "Couldn't read %lld tracks"
                }
              }
            }
          }
        },
        "ja" : {
