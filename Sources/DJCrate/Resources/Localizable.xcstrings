    },
    "USB에 넣지 못한 곡이라 재생 목록에서 뺐습니다. 곡 더하기가 막힌 이유를 푼 뒤 다시 동기화하세요" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Removed from the playlist because the track couldn't be added to the USB. Resolve why adding it was blocked, then sync again"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "USBに入れられなかった曲のため、プレイリストから外しました。曲の追加がブロックされた理由を解決してから、もう一度同期してください"
          }
        }
      }
    },
    "USB에 넣지 못할 곡 %lld개:" : {
      "localizations" : {
        "en" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
