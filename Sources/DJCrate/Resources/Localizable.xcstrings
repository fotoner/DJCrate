        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "復元ポイントを作成"
          }
        }
      }
    },
    "지금 연 사본(--db)에는 보이지 않으니 --db 없이 다시 열어 확인하세요." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
