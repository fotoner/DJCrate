          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "コレクションに曲が1曲もないため、このライブラリの機器情報がわかりません。rekordboxで曲を1曲追加してから、もう一度お試しください"
          }
        }
      }
    },
