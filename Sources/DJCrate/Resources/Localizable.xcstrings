    },
    "지금 라이브러리와 다른 곳이 없습니다." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No differences from the current library."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "現在のライブラリとの違いはありません。"
          }
        }
      }
    },
    "지금 목록에서 몇 번째 곡인지" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Position of the track in the current list"
